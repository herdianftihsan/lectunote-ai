# LectuNote AI Environment Variables
# Duplikat file ini menjadi .env.local dan isi nilai API Key Anda

# 1. Supabase Configuration (Free Tier PostgreSQL & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Google Gemini API Configuration (Google AI Studio)
# Dapatkan API Key gratis di: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key
# Opsional: override model (default: gemini-3.5-flash-lite). gemini-1.5-flash sudah dimatikan Google.
# GEMINI_MODEL=gemini-3.5-flash-lite
